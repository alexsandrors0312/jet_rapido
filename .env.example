DATABASE_URL=postgresql+psycopg://jet_rapido:jet_rapido@localhost:5432/jet_rapido
MAX_UPLOAD_BYTES=5242880
MAX_XLSX_UNCOMPRESSED_BYTES=52428800
MAX_XLSX_ENTRIES=1000
MAP_PROVIDER=straight_line
MAX_MATRIX_POINTS=200
OSRM_BASE_URL=http://localhost:5000
OSRM_PROFILE=foot
OSRM_TIMEOUT_SECONDS=20
OSRM_BLOCK_SIZE=50
OSRM_DATASET_REVISION=unverified
OSRM_SNAP_RADIUS_M=50
STRAIGHT_LINE_DETOUR_FACTOR=1.25
WALKING_SPEED_MPS=1.3
# Ordem veicular (etapa 5): provedor separado do pedestre. Sem configuração
# explícita a ordem é recusada, em vez de reaproveitar a matriz pedestre.
VEHICLE_MAP_PROVIDER=unconfigured
VEHICLE_OSRM_BASE_URL=
VEHICLE_OSRM_PROFILE=car
VEHICLE_OSRM_TIMEOUT_SECONDS=20
VEHICLE_OSRM_BLOCK_SIZE=50
VEHICLE_OSRM_DATASET_REVISION=unverified
VEHICLE_OSRM_SNAP_RADIUS_M=100
VEHICLE_EXACT_BASE_LIMIT=12
